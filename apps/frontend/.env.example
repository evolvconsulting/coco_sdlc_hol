# Snowflake connection — copy to .env.local and fill in your values.
# NEVER commit .env.local to version control.

# Snowflake account identifier (format: orgname-accountname, e.g. myorg-myaccount)
SNOWFLAKE_ACCOUNT=<your-orgname-accountname>

# Snowflake user credentials (replace NN with your assigned number)
SNOWFLAKE_USER=HOL_USER_NN
SNOWFLAKE_PASSWORD=<your-password>

# Role and warehouse (replace NN with your assigned number)
SNOWFLAKE_ROLE=HOL_ROLE_NN
SNOWFLAKE_WAREHOUSE=HOL_WH_NN

# Database and schema (replace NN with your assigned number)
SNOWFLAKE_DATABASE=COCO_SDLC_HOL_NN
SNOWFLAKE_SCHEMA=MARTS

# Cortex Agent name (pre-created as part of HOL setup)
CORTEX_AGENT_NAME=PAYMENT_ANALYTICS_AGENT
