# Snowflake connection — copy to .env.local and fill in your values.
# NEVER commit .env.local to version control.

# Snowflake account identifier (format: orgname-accountname, e.g. myorg-myaccount)
SNOWFLAKE_ACCOUNT=<your-orgname-accountname>

# Snowflake user for service account JWT auth
SNOWFLAKE_USER=COCO_SDLC_HOL_SERVICE_USER

# Role and warehouse
SNOWFLAKE_ROLE=ATTENDEE_ROLE
SNOWFLAKE_WAREHOUSE=COMPUTE_WH

# Unencrypted RSA private key PEM content (for JWT key-pair auth).
# Generate with: openssl genrsa 2048 | openssl pkcs8 -topk8 -inform PEM -out rsa_key.p8 -nocrypt
# Then register the public key: ALTER USER COCO_SDLC_HOL_SERVICE_USER SET RSA_PUBLIC_KEY='<public_key>';
SNOWFLAKE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----
<PASTE_YOUR_UNENCRYPTED_PRIVATE_KEY_HERE>
-----END PRIVATE KEY-----

# Database and schema
SNOWFLAKE_DATABASE=COCO_SDLC_HOL_01
SNOWFLAKE_SCHEMA=MARTS

# Cortex Agent name (created in Section 8)
CORTEX_AGENT_NAME=COCO_SDLC_HOL_AGENT
